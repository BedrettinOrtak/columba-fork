    <!-- Battery & Background card -->
    <string name="battery_title">Batarî û Paşî</string>
    <string name="battery_description">Hilbijêrin ka Boran çiqas bi hêz Reticulum xwecihî li paşî bixebite. Guhartin rasterast tên sepandin.</string>
