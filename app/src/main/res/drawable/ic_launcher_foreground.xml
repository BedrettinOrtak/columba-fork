<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground for the Columba launcher icon.

  TUNING NOTES (manual): the visible canvas is 108dp x 108dp but every
  launcher applies a mask that crops everything outside the inner ~72dp
  safe zone. We render the dove inside a centred sub-box and tell the
  bitmap to fill that box so it actually scales (gravity=center alone
  draws the 1080x1080 PNG at its native size and you only see a tiny
  cropped slice of the centre).

  - android:width / android:height on the <item> = the visible diameter
    of the dove inside the icon. 80dp is the sweet spot: large enough
    to read clearly on round Pixel-style masks, small enough that
    nothing gets clipped on aggressive squircle masks.
  - android:gravity="fill_horizontal|fill_vertical" on the <bitmap>
    forces the PNG to scale to that 80x80 box (preserves aspect because
    the source PNG is square).

  If the dove still looks too small, bump width/height to 88dp or 92dp.
  If it gets clipped on Samsung/MIUI launchers, drop to 72dp.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:width="80dp"
        android:height="80dp">
        <bitmap
            android:src="@drawable/ic_launcher_fg"
            android:gravity="fill_horizontal|fill_vertical"
            android:antialias="true"
            android:filter="true" />
    </item>
</layer-list>
